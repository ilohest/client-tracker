rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /clients/{userId}/{clientId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/profile/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
